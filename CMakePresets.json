{
  "version": 3,
  "configurePresets": [
    { "name": "windows", "generator": "Visual Studio 17 2022", "architecture": "x64", "binaryDir": "${sourceDir}/build/windows" },
    { "name": "ninja", "generator": "Ninja", "binaryDir": "${sourceDir}/build/ninja", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } }
  ],
  "buildPresets": [{ "name": "windows", "configurePreset": "windows", "configuration": "Release" }, { "name": "ninja", "configurePreset": "ninja" }],
  "testPresets": [{ "name": "windows", "configurePreset": "windows", "configuration": "Release", "output": { "outputOnFailure": true } }, { "name": "ninja", "configurePreset": "ninja", "output": { "outputOnFailure": true } }]
}
